# Copy this file to tools/.env and fill in your own values.
# tools/.env is gitignored - never commit it.

# From your app at https://developer.upstox.com/
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must exactly match the redirect URI registered on your Upstox app.
UPSTOX_REDIRECT_URI=http://localhost:5000/callback

# A GitHub Personal Access Token scoped to ONLY this repo, with
# "Secrets" set to "Read and write" (fine-grained token) - used to push
# the refreshed access token straight to the UPSTOX_ACCESS_TOKEN secret.
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
GITHUB_OWNER=sapanz
GITHUB_REPO=nifty-trading-screener
